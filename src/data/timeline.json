  {
   "id": "intro",
   "from": 0,
   "duration": 418,
   "lines": [
    {
     "text": "1999 թվականի հոկտեմբերի 27։",
     "audio": "audio/voice/intro_1.wav",
     "start": 70,
     "duration": 173,
     "human": false
    },
    {
     "text": "Մի օր, որը փոխեց Հայաստանի պատմությունը։",
     "audio": "audio/voice/intro_2.wav",
     "start": 255,
     "duration": 128,
     "human": false
    }
   ]
  },
  {
   "id": "map",
   "from": 418,
   "duration": 351,
   "lines": [
    {
     "text": "Երևան։ Հայաստանի Ազգային ժողով։",
     "audio": "audio/voice/map_1.wav",
     "start": 30,
     "duration": 121,
     "human": false
    },
    {
     "text": "Մայիսյան ընտրություններում հաղթել էր «Միասնություն» դաշինքը։",
     "audio": "audio/voice/map_2.wav",
     "start": 163,
     "duration": 153,
     "human": false
    }
   ]
  },
  {
   "id": "leaders",
   "from": 769,
   "duration": 623,
   "lines": [
    {
     "text": "Վարչապետ էր դարձել Վազգեն Սարգսյանը՝ Ղարաբաղյան պատերազմի հերոսն ու նախկին պաշտպանության նախարարը։",
     "audio": "audio/voice/leaders_1.wav",
     "start": 30,
     "duration": 287,
     "human": false
    },
    {
     "text": "Ազգային ժողովի նախագահ էր ընտրվել Կարեն Դեմիրճյանը՝ Խորհրդային Հայաստանի նախկին ղեկավարը։",
     "audio": "audio/voice/leaders_2.wav",
     "start": 329,
     "duration": 259,
     "human": false
    }
   ]
  },
  {
   "id": "attack",
   "from": 1392,
   "duration": 878,
   "lines": [
    {
     "text": "Հոկտեմբերի 27-ի երեկոյան խորհրդարանում նիստ էր ընթանում, տեսախցիկները նկարահանում էին։",
     "audio": "audio/voice/attack_1.wav",
     "start": 40,
     "duration": 258,
     "human": false
    },
    {
     "text": "Մոտ ժամը 17:15-ին հինգ զինված անձինք՝ Նաիրի Հունանյանի գլխավորությամբ, ներխուժեցին դահլիճ և կրակ բացեցին։",
     "audio": "audio/voice/attack_2.wav",
     "start": 310,
     "duration": 349,
     "human": false
    },
    {
     "text": "Վարչապետ Վազգեն Սարգսյանը սպանվեց տեղում։",
     "audio": "audio/voice/attack_3.wav",
     "start": 671,
     "duration": 132,
     "human": false
    }
   ]
  },
  {
   "id": "victims",
   "from": 2270,
   "duration": 366,
   "lines": [
    {
     "text": "Զոհվեց ութ մարդ։",
     "audio": "audio/voice/victims_1.wav",
     "start": 30,
     "duration": 58,
     "human": false
    },
    {
     "text": "Նրանց թվում էին խորհրդարանի նախագահը, երկու փոխնախագահները և մեկ նախարար։",
     "audio": "audio/voice/victims_2.wav",
     "start": 100,
     "duration": 231,
     "human": false
    }
   ]
  },
  {
   "id": "siege",
   "from": 2636,
   "duration": 732,
   "lines": [
    {
     "text": "Ամբողջ գիշեր զինյալները պատանդ էին պահում տասնյակ պատգամավորների և պաշտոնյաների։",
     "audio": "audio/voice/siege_1.wav",
     "start": 30,
     "duration": 228,
     "human": false
    },
    {
     "text": "Նախագահ Ռոբերտ Քոչարյանը անձամբ բանակցում էր նրանց հետ։",
     "audio": "audio/voice/siege_2.wav",
     "start": 270,
     "duration": 164,
     "human": false
    },
    {
     "text": "Հոկտեմբերի 28-ի առավոտյան պատանդներն ազատ արձակվեցին, իսկ զինյալները հանձնվեցին։",
     "audio": "audio/voice/siege_3.wav",
     "start": 446,
     "duration": 251,
     "human": false
    }
   ]
  },
  {
   "id": "aftermath",
   "from": 3368,
   "duration": 801,
   "lines": [
    {
     "text": "2003 թվականին Նաիրի Հունանյանը և նրա հանցակիցները դատապարտվեցին ցմահ ազատազրկման։",
     "audio": "audio/voice/aftermath_1.wav",
     "start": 30,
     "duration": 289,
     "human": false
    },
    {
     "text": "Հայաստանը մեկ օրում կորցրեց իր երկու ամենաազդեցիկ ղեկավարներին։",
     "audio": "audio/voice/aftermath_2.wav",
     "start": 331,
     "duration": 185,
     "human": false
    },
    {
     "text": "Թե արդյոք որևէ մեկը կանգնած էր հանցագործների թիկունքում, մինչ օրս վիճելի հարց է։",
     "audio": "audio/voice/aftermath_3.wav",
     "start": 528,
     "duration": 238,
     "human": false
    }
   ]
  },
  {
