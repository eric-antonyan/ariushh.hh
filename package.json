{
  "name": "oct27-1999-motion",
  "version": "1.0.0",
  "private": true,
  "description": "Armenian motion-graphics documentary of the 27 October 1999 parliament shooting (landscape + reel), built with Remotion",
  "scripts": {
    "start": "remotion studio",
    "assets": "python3 scripts/make_voice.py && python3 scripts/make_audio.py",
    "render": "remotion render Oct27 out/oct27-1999.mp4",
    "render:reel": "remotion render Oct27Reel out/oct27-1999-reel.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "^4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
